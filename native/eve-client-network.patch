+static int configure_eve_client_network(Tracee *tracee, const char *mode)
+{
+	Extension *extension = get_extension(tracee, eve_client_network_callback);
+	/* Reuse one policy object when the statistics option is combined with
+	 * either network option. Failure never silently drops containment. */
+	if (extension != NULL)
+		return eve_client_network_callback(extension, INITIALIZATION, (intptr_t)mode, 0);
+	return initialize_extension(tracee, eve_client_network_callback, mode);
+}
+
+static int handle_option_eve_client_network(Tracee *tracee, const Cli *cli UNUSED, const char *value UNUSED)
+{
+	return configure_eve_client_network(tracee, NULL);
+}
+
+static int handle_option_eve_client_network_fast_sendto(Tracee *tracee, const Cli *cli UNUSED, const char *value UNUSED)
+{
+	return configure_eve_client_network(tracee, "fast-sendto");
+}
+
+static int handle_option_eve_client_network_stats(Tracee *tracee, const Cli *cli UNUSED, const char *value UNUSED)
+{
+	return configure_eve_client_network(tracee, "stats");
+}
